{
  "name": "vite-plugin-approuter",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "create-approuter-app": "./bin/create-approuter-app.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:playground": "vite --config playground/vite.config.ts",
    "dev:playground:tanstack": "vite --config playground/vite.tanstack.config.ts"
  },
  "peerDependencies": {
    "vite": ">=4.0.0",
    "react": ">=17.0.0",
    "react-router-dom": ">=6.0.0"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.132.27",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.8"
  }
}
